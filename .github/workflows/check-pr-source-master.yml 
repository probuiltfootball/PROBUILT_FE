name: Check PR Source Branch

on:
  pull_request:
    branches: [master]
    types: [opened, reopened, synchronize, edited]

jobs:
  check-branch:
    runs-on: ubuntu-latest
    steps:
      - name: Check source branch
        run: |
          if [ "${{ github.head_ref }}" != "develop" ]; then
            echo "ERROR: Only pull requests from develop branch are allowed to merge into master"
            exit 1
          fi
          echo "Source branch is develop - approved"